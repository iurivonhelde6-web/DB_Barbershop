# ─── APP ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# URL onde o app está hospedado (Cloud Run injeta automaticamente)
APP_URL="https://your-app.run.app"

# ─── STRIPE ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
VITE_STRIPE_PUBLIC_KEY=pk_live_

# ─── ADMIN ────────────────────────────────────────────────────────────────────
# NÃO existe mais variável de e-mail de admin. O papel de administrador vem do
# custom claim `admin` do Firebase Auth, concedido com:
#   npm run set-admin -- email@dominio.com
# (ADMIN_EMAIL e VITE_ADMIN_EMAIL foram removidos: uma var VITE_* vai inteira para
#  o bundle do navegador e nunca deve carregar decisão de autorização.)

# ─── FIREBASE (Cliente / Vite) ────────────────────────────────────────────────
# Obrigatórias: sem elas o firebaseConfig fica vazio e o login não inicializa.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── GEMINI AI ────────────────────────────────────────────────────────────────
# AI Studio injeta automaticamente via painel de Secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── FIREBASE ADMIN SDK (Backend) ─────────────────────────────────────────────
# Em Cloud Run/GCP: Application Default Credentials (não precisa configurar manualmente)
# Localmente: aponte para o arquivo ou cole o JSON aqui
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/service-account.json"
# FIREBASE_SERVICE_ACCOUNT_JSON="{...}"
