rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Privilégio de administrador vem EXCLUSIVAMENTE do custom claim assinado pelo
    // Firebase Auth (definido via Admin SDK: npm run set-admin -- <email>).
    // Nenhum e-mail é hardcoded aqui: e-mail é identidade, não autorização.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    function owner(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if owner(userId) || isAdmin();
      allow create: if owner(userId)
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.role == 'client'
            || (isAdmin() && request.resource.data.role == 'admin'));
      // O dono edita os próprios dados pessoais, mas nunca o próprio papel
      allow update: if (owner(userId) && request.resource.data.role == resource.data.role)
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid
        && request.resource.data.userUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
