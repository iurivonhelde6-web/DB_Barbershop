rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'iurivonheldetatuador@gmail.com'
      );
    }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if owner(userId) || isAdmin();
      allow create: if owner(userId)
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.role == 'client'
            || (request.auth.token.email == 'iurivonheldetatuador@gmail.com' && request.resource.data.role == 'admin'));
      allow update: if (owner(userId) && request.resource.data.role == resource.data.role)
        || (request.auth.token.email == 'iurivonheldetatuador@gmail.com' && request.resource.data.role == 'admin')
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid
        && request.resource.data.userUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
